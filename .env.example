# Copy to .env to enable optional notifications. Never commit .env.
# Optional locally obtained training data (a compatible JSONL file).
# RAN_MONITOR_DATA_PATH=C:/path/to/authorized-windows.jsonl
# Optional SQLite storage location (blank = alerts.sqlite3 in the project).
# RAN_MONITOR_DB_PATH=C:/path/to/alerts.sqlite3

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
